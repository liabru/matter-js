{
  "name": "matter-js",
  "version": "0.20.0",
  "license": "MIT",
  "homepage": "http://brm.io/matter-js/",
  "author": "Liam Brummitt <liam@brm.io> (http://brm.io/)",
  "description": "a 2D rigid body physics engine for the web",
  "main": "build/matter.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/liabru/matter-js.git"
  },
  "keywords": [
    "javascript",
    "canvas",
    "html5",
    "physics",
    "physics engine",
    "game engine",
    "rigid body physics"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-worker": "^30.4.1",
    "json-stringify-pretty-compact": "^3.0.0",
    "matter-wrap": "^0.2.0",
    "mock-require": "^3.0.3",
    "pathseg": "^1.2.1",
    "poly-decomp": "^0.3.0",
    "rollup": "^4.60.4",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-serve": "^3.0.0"
  },
  "scripts": {
    "start": "pnpm run serve",
    "dev": "pnpm run serve",
    "serve": "rollup -w -c rollup.config.demo.mjs",
    "build": "rollup -c",
    "build-alpha": "rollup -c --environment KIND:alpha & rollup -c --environment MINIMIZE:true,KIND:alpha",
    "build-dev": "rollup -c --environment KIND:dev & rollup -c --environment MINIMIZE:true,KIND:dev",
    "build-demo": "rollup -c rollup.config.demo.mjs",
    "lint": "pnpm run lint-all",
    "lint-fix": "pnpm run lint-all -- --fix",
    "lint-all": "eslint 'src/**/*.js' 'demo/src/**/*.js' 'examples/*.js' 'rollup.*'",
    "lint-files": "eslint",
    "benchmark": "pnpm run test-node -- --examples=stress3,stress4 --benchmark=true --updates=300 --repeats=3",
    "test": "pnpm run test-node",
    "test-node": "pnpm run build-dev && node --expose-gc ./node_modules/jest/bin/jest.js --force-exit --no-cache --runInBand ./test/Examples.spec.js",
    "test-save": "pnpm run test-node -- --save=true",
    "test-watch": "pnpm run test-node -- --watch"
  },
  "files": [
    "src",
    "build/matter.js",
    "build/matter.min.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "matter-tools": "^0.14.0"
  }
}
